# ============================================================================
# PrimeraInfancia 2.7.0 — Planeación Operativa y Componente Psicosocial
# Este archivo es solo una plantilla. No escriba aquí secretos reales.
# ============================================================================

# Entorno y persistencia
APP_ENV=production
APP_VERSION=2.7.2-document-center

# Biblioteca Oficial ICBF: la consulta remota queda cerrada por defecto.
# Solo habilitar cuando exista un catálogo JSON oficial, autorizado y documentado.
BIBLIOTECA_REMOTE_CHECKS_ENABLED=false
BIBLIOTECA_ALLOWED_DOMAINS=icbf.gov.co,www.icbf.gov.co

# Motor Inteligente de Gestión del Proyecto
MOTOR_GESTION_ENABLED=true
MOTOR_GESTION_MAX_EXPORT_ROWS=5000
DATA_DIR=/data

# Base recomendada para producción. Railway/servicio PostgreSQL entrega esta URL.
# Se normaliza internamente al driver psycopg. No la confirme en Git.
DATABASE_URL=postgresql://USUARIO:PASSWORD@HOST:5432/BASE

# LÍA — activación gradual (valores seguros por defecto)
ENABLE_LIA_ASSISTANT=false
LIA_TEXT_ENABLED=true
LIA_CONTEXT_HELP_ENABLED=true
LIA_GUIDED_TOURS_ENABLED=true
LIA_VOICE_ENABLED=false
LIA_BROWSER_TTS_ENABLED=true
LIA_REALTIME_ENABLED=false
LIA_AI_ENABLED=false
LIA_FEEDBACK_ENABLED=true
LIA_DIAGNOSTICS_ENABLED=true
LIA_MAX_MESSAGE_LENGTH=2000
LIA_RATE_LIMIT_PER_MINUTE=20
LIA_PROVIDER=openai
LIA_TEXT_MODEL=
LIA_REALTIME_MODEL=
LIA_TRANSCRIPTION_MODEL=
LIA_TTS_MODEL=
LIA_PLATFORM_DESIGNER=
LIA_PLATFORM_CREATED_DATE=
LIA_PLATFORM_DESCRIPTION=

# LIAM — evolución visual segura de LÍA. Desactivado inicialmente.
ENABLE_LIAM_ASSISTANT=false
ENABLE_IAN_ASSISTANT=false
IAN_ASSISTANT_NAME=IAN
LIAM_TEXT_ENABLED=true
LIAM_VOICE_ENABLED=false
LIAM_ANIMATION_ENABLED=true
LIAM_WALK_ENABLED=false
LIAM_TELEPORT_ENABLED=true
LIAM_LIP_SYNC_ENABLED=false
LIAM_HOLOGRAM_ENABLED=true
LIAM_CONTEXT_GUIDE_ENABLED=true
LIAM_TOURS_ENABLED=true
LIAM_PLATFORM_PRESENTATION_ENABLED=true
LIAM_TABLET_DISPLAY_ENABLED=true
LIAM_MINI_HELP_ENABLED=false
LIAM_AI_ENABLED=false
LIAM_REALTIME_VOICE_ENABLED=false
LIAM_PERFORMANCE_MODE=auto
LIAM_DEFAULT_MOTION_LEVEL=light
ENABLE_POSTGRESQL_RUNTIME=true
ENABLE_CREDIT_ENFORCEMENT=false
ENABLE_CREDIT_ALERTS=true
REQUIRE_POSTGRESQL_IN_PRODUCTION=true
DB_POOL_SIZE=8
DB_MAX_OVERFLOW=12
DB_POOL_TIMEOUT_SECONDS=15
DB_POOL_RECYCLE_SECONDS=1200
DB_CONNECT_TIMEOUT_SECONDS=10
DB_STATEMENT_TIMEOUT_MS=30000
DB_APPLICATION_NAME=primera-infancia-2.7.0
# Opcional en Railway. Los scripts Windows generan una huella propia por copia.
PROJECT_INSTANCE_ID=
SINGLE_TENANT_MODE=false
ALLOW_EXPERIMENTAL_MULTI_TENANT=true
MULTI_TENANT_STRICT=true
TENANT_STORAGE_ISOLATION=true
MULTI_TENANT_SCHEMA_VERSION=3
SYNC_MANAGED_TEMPLATES=true

# Motor Universal Tabular. Mantener apagado hasta aplicar predeploy y ejecutar el piloto.
ENABLE_UNIVERSAL_DATA_MAPPER=false
UNIVERSAL_IMPORT_MAX_BYTES=52428800


# Integridad, observabilidad y estabilidad
INTEGRITY_ENGINE_ENABLED=true
METRICS_ENABLED=true
# Configure un token largo si las métricas se consultarán desde un monitor externo.
METRICS_TOKEN=
READINESS_MAX_DB_LATENCY_MS=2000
STRUCTURED_HTTP_LOGS=true

# Genere dos valores aleatorios, diferentes, de 64 caracteres o más.
SECRET_KEY=REEMPLAZAR_CON_SECRETO_ALEATORIO_1
JWT_SECRET_KEY=REEMPLAZAR_CON_SECRETO_ALEATORIO_2

# Administrador de arranque. Se usa solamente cuando el volumen está vacío.
# Nunca use credenciales predeterminadas ni una contraseña reutilizada.
INITIAL_ADMIN_USERNAME=REEMPLAZAR_CON_USUARIO_NO_PREDECIBLE
INITIAL_ADMIN_EMAIL=administrador@ejemplo.com
INITIAL_ADMIN_PASSWORD=REEMPLAZAR_CON_PASSWORD_FUERTE
INITIAL_ADMIN_NAME=Administrador inicial
INITIAL_ADMIN_FORCE_PASSWORD_CHANGE=true
INITIAL_FOUNDATION_NAME=Fundación piloto inicial

# Railway proporciona RAILWAY_PUBLIC_DOMAIN después de generar el dominio.
RAILWAY_PUBLIC_DOMAIN=
PUBLIC_APP_URL=https://${{ RAILWAY_PUBLIC_DOMAIN }}
FRONTEND_ORIGIN=https://${{ RAILWAY_PUBLIC_DOMAIN }}
ALLOWED_ORIGINS=
TRUSTED_PROXY_COUNT=1
FORCE_HTTPS=true

# Sesiones, contraseñas y protección contra abuso
SESSION_LIFETIME_MINUTES=720
MIN_PASSWORD_LENGTH=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
LOGIN_LOCK_SECONDS=900
# Reintentos internos breves para el login; mantienen la respuesta por debajo de 2 segundos.
LOGIN_DB_RETRY_ATTEMPTS=4
LOGIN_DB_BUSY_TIMEOUT_MS=150
LOGIN_DB_RETRY_BASE_MS=50
LOGIN_DB_RETRY_BUDGET_MS=1200
LOGIN_SLOW_THRESHOLD_MS=1500
RECOVERY_MAX_ATTEMPTS=5
RECOVERY_WINDOW_SECONDS=3600
RECOVERY_LOCK_SECONDS=3600
PASSWORD_RESET_EXPIRES_MINUTES=30

# Recuperación por Gmail SMTP. Usa una contraseña de aplicación, nunca la clave normal.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=15
PASSWORD_RESET_FROM_EMAIL=
PASSWORD_RESET_PUBLIC_URL=https://${{ RAILWAY_PUBLIC_DOMAIN }}

# Compatibilidad insegura: debe permanecer desactivada.
ALLOW_LEGACY_QUERY_TOKENS=false
ALLOW_PASSWORD_RESET_TOKEN_RESPONSE=false
# Solo puede activarse en desarrollo local sin túnel público.
ALLOW_LOCAL_RECOVERY_CODE=false
LOCAL_RECOVERY_CODE_LENGTH=10
RESET_MAX_ATTEMPTS=8
RESET_WINDOW_SECONDS=900
RESET_LOCK_SECONDS=900
ENABLE_LEGACY_TENANT_BACKFILL=false

# Centro Documental institucional. Activación gradual después de migración y piloto.
ENABLE_DOCUMENT_AUTOMATION=true
ENABLE_TEMPLATE_MAPPING=true
ENABLE_RESPONSE_CATALOGS=true
ENABLE_AI_DOCUMENT_DRAFTS=false
ENABLE_AI_DOCUMENT_FINALIZATION=false
# CAPTURE permanece desactivado hasta cargar, mapear, probar y aprobar la plantilla oficial real.
ENABLE_CAPTURE_FORMAT=false

# Ejecución. PostgreSQL admite concurrencia; mantener un worker hasta externalizar jobs en memoria.
GUNICORN_WORKERS=1
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=300
SQLITE_TIMEOUT_SECONDS=30
LOG_LEVEL=INFO
